# Crawl4AI LLM 环境变量配置示例
# 
# 说明：只需要配置一个默认的 LLM provider 和对应的 API key 即可使用 LLM 功能
# 系统会自动根据 provider 名称找到对应的 API key（通过 LiteLLM）
# 
# 复制命令: cp .llm.env.example .llm.env
# 然后取消下面你需要的配置的注释并填写实际的 API Key
# 
# 在 docker-compose.yml 中取消 env_file 的注释以启用
# 或使用 docker run 时添加: --env-file .llm.env

# ============================================
# 必需配置：选择一个默认 LLM Provider
# ============================================
# LLM_PROVIDER=openai/gpt-4o-mini          # 默认 LLM 提供商和模型（必需）

# ============================================
# 必需配置：根据上面选择的 provider 填写对应的 API Key
# ============================================

# OpenAI (如果 LLM_PROVIDER 使用 openai/*)
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic (如果 LLM_PROVIDER 使用 anthropic/*)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Gemini (如果 LLM_PROVIDER 使用 gemini/*)
# GEMINI_API_KEY=your-gemini-api-key

# Groq (如果 LLM_PROVIDER 使用 groq/*)
# GROQ_API_KEY=your-groq-api-key

# DeepSeek (如果 LLM_PROVIDER 使用 deepseek/*)
# DEEPSEEK_API_KEY=your-deepseek-api-key

# Together (如果 LLM_PROVIDER 使用 together/*)
# TOGETHER_API_KEY=your-together-api-key

# Mistral (如果 LLM_PROVIDER 使用 mistral/*)
# MISTRAL_API_KEY=your-mistral-api-key

# Ollama 本地模型 (如果 LLM_PROVIDER 使用 ollama/*)
# OLLAMA_BASE_URL=http://host.docker.internal:11434  # 从容器内访问宿主机上的 Ollama

# ============================================
# 可选配置：全局参数（适用于所有 provider）
# ============================================
# LLM_TEMPERATURE=0.7                       # 默认温度参数（0.0-2.0）
# LLM_BASE_URL=                             # 默认 API 基础 URL（用于自定义 OpenAI 兼容接口）

# ============================================
# 可选配置：Provider 专用参数（覆盖全局设置）
# ============================================
# OPENAI_TEMPERATURE=0.7                    # OpenAI 专用温度
# OPENAI_BASE_URL=https://api.openai.com/v1 # OpenAI 专用基础 URL（可用于代理）
# ANTHROPIC_TEMPERATURE=0.7                  # Anthropic 专用温度

# ============================================
# 使用说明
# ============================================
# 1. 最少只需要配置：
#    - LLM_PROVIDER=openai/gpt-4o-mini
#    - OPENAI_API_KEY=sk-your-key
# 
# 2. 如果需要在请求中使用其他 provider，只需在 .llm.env 中添加对应的 API key
#    例如：添加 ANTHROPIC_API_KEY，就可以在请求中使用 anthropic/claude-3-opus
# 
# 3. 系统会自动根据 provider 名称找到对应的环境变量
#    支持的格式: {PROVIDER}_API_KEY 或 {PROVIDER}_API_TOKEN