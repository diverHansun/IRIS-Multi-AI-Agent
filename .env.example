# 多LLM智能Agent Demo 环境变量配置模板
# 复制此文件为.env并填入您的API密钥

# LLM API密钥（至少需要配置一个）
# 智谱AI API密钥 - 请访问 https://open.bigmodel.cn/ 获取
ZHIPU_API_KEY=your_zhipu_api_key_here

# OpenAI API密钥 - 请访问 https://platform.openai.com/ 获取
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI API 自定义端点（可选）- 如使用代理服务
# OPENAI_BASE_URL=https://api.openai-proxy.org/v1

# 搜索引擎API密钥（可选，推荐配置以获得更好的搜索体验）
# Tavily搜索API - 请访问 https://www.tavily.com/ 获取
TAVILY_API_KEY=your_tavily_api_key_here

# 高德地图API密钥（可选，用于地图搜索和导航功能）
# 高德地图API - 请访问 https://lbs.amap.com/ 获取
AMAP_API_KEY=your_amap_api_key_here

# Notion集成配置（可选，用于连接Notion笔记数据库）
# Notion Integration Token - 请访问 https://www.notion.so/my-integrations 创建
NOTION_TOKEN=secret_your_notion_integration_token_here
# Notion MCP服务器地址（通常不需要修改）
NOTION_MCP_URL=https://mcp.notion.com/mcp

# 默认LLM配置（可选）
DEFAULT_LLM_PROVIDER=zhipu
DEFAULT_LLM_MODEL=glm-4-plus

# 注意事项：
# 1. 请确保此文件使用UTF-8编码格式保存
# 2. 不要将包含真实API密钥的.env文件提交到版本控制系统
# 3. 智谱AI密钥格式：abcd1234.efgh5678ijkl9012mnop3456
# 4. OpenAI密钥格式：sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 5. Notion令牌格式：ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 6. 至少需要配置一个LLM的API密钥才能运行程序
# 7. Notion功能需要创建Integration并为页面/数据库添加连接权限
