# Crawl4AI 配置文件 (带注释说明)
# 实际使用时请复制为 config.json 并移除所有注释行

{
  # ============================================
  # 基础连接配置
  # ============================================
  "default": {
    "base_url": "http://localhost:11235",  # Crawl4AI Docker 服务地址
    "timeout": 60,                          # 普通请求超时(秒)
    "stream_timeout": 120,                  # 流式请求超时(秒)
    "retry_attempts": 2,                    # 失败重试次数
    "token": null                           # 认证令牌(可选)
  },

  # ============================================
  # 浏览器配置 (BrowserConfig)
  # 控制浏览器实例的行为
  # ============================================
  "browser": {
    # --- 基础配置 (常用) ---
    "browser_type": "chromium",             # 浏览器类型: chromium/firefox/webkit
    "headless": true,                       # 无头模式(不显示浏览器窗口)
    "viewport_width": 1080,                 # 视口宽度(像素)
    "viewport_height": 600,                 # 视口高度(像素)
    "user_agent": "Mozilla/5.0...",         # 用户代理字符串
    "ignore_https_errors": true,            # 忽略HTTPS证书错误
    "java_script_enabled": true,            # 启用JavaScript

    # --- 高级配置 ---
    "browser_mode": "dedicated",            # 浏览器模式: builtin/dedicated/cdp/docker
    "enable_stealth": false,                # 反检测模式(绕过爬虫检测)
    "proxy": null,                          # 代理服务器地址
    "extra_args": [],                       # 额外的浏览器启动参数
    "accept_downloads": false,              # 是否接受下载
    "text_mode": false,                     # 文本模式(禁用图片加载)
    "light_mode": false,                    # 轻量模式(减少资源使用)

    # --- 很少使用的配置 ---
    "use_managed_browser": false,
    "cdp_url": null,
    "use_persistent_context": false,
    "user_data_dir": null,
    "chrome_channel": "chromium",
    "downloads_path": null,
    "cookies": [],
    "headers": {},
    "user_agent_mode": "",
    "user_agent_generator_config": {},
    "debugging_port": 9222,
    "host": "localhost"
  },

  # ============================================
  # 爬虫配置 (CrawlerRunConfig)
  # 控制每次爬取操作的行为
  # ============================================
  "crawler": {
    # --- 内容处理 (常用) ---
    "word_count_threshold": 200,            # 最小字数阈值
    "only_text": false,                     # 仅提取纯文本
    "excluded_tags": [                      # 排除的HTML标签
      "nav", "footer", "aside", "script", "style"
    ],
    "css_selector": null,                   # CSS选择器(提取特定内容)
    "target_elements": [],                  # 目标元素选择器列表
    "excluded_selector": "",                # 排除内容的选择器

    # --- 页面加载 (常用) ---
    "wait_until": "domcontentloaded",       # 等待条件: domcontentloaded/load/networkidle
    "page_timeout": 60000,                  # 页面超时(毫秒)
    "wait_for": null,                       # 等待特定元素/条件
    "delay_before_return_html": 0.1,        # 返回前延迟(秒)

    # --- 交互行为 (按需使用) ---
    "scan_full_page": false,                # 滚动整页加载内容
    "scroll_delay": 0.2,                    # 滚动延迟(秒)
    "max_scroll_steps": null,               # 最大滚动次数
    "simulate_user": false,                 # 模拟用户行为
    "remove_overlay_elements": false,       # 移除遮罩层/弹窗
    "magic": false,                         # 自动处理弹窗
    "js_code": null,                        # 执行的JavaScript代码

    # --- 媒体处理 ---
    "screenshot": false,                    # 截图(返回base64)
    "screenshot_wait_for": null,            # 截图前等待时间
    "pdf": false,                           # 生成PDF(返回base64)
    "exclude_external_images": false,       # 排除外部图片
    "exclude_all_images": false,            # 排除所有图片

    # --- 缓存和性能 ---
    "cache_mode": "bypass",                 # 缓存模式: enabled/bypass/disabled
    "semaphore_count": 5,                   # 并发限制数
    "mean_delay": 0.1,                      # 平均延迟(秒)
    "max_range": 0.3,                       # 延迟随机范围

    # --- 链接控制 ---
    "exclude_external_links": false,        # 排除外部链接
    "exclude_internal_links": false,        # 排除内部链接
    "exclude_social_media_links": false,    # 排除社交媒体链接
    "exclude_domains": [],                  # 排除的域名列表

    # --- LLM优化参数 (重要!) ---
    "return_format": "markdown",            # 返回格式: markdown/json
    "content_filter_type": null,            # 内容过滤: pruning/bm25/none
    "pruning_threshold": 0.48,              # 修剪阈值(0-1)
    "pruning_threshold_type": "fixed",      # 阈值类型: fixed/dynamic
    "min_word_threshold": 30,               # 最小词数阈值
    "bm25_threshold": 1.0,                  # BM25相关性阈值
    "user_query": null,                     # BM25查询关键词
    "max_token_length": null,               # 最大token长度
    "prefer_fit_markdown": false,           # 优先返回fit_markdown
    "extract_main_content": false,          # 提取主要内容区域

    # --- 调试和日志 ---
    "verbose": true,                        # 详细日志
    "log_console": false,                   # 记录控制台日志
    "capture_console_messages": false,      # 捕获控制台消息

    # --- 高级配置 (很少使用) ---
    "parser_type": "lxml",
    "scraping_strategy": null,
    "proxy_config": null,
    "locale": null,
    "timezone_id": null,
    "geolocation": null,
    "session_id": null,
    "process_iframes": false,
    "override_navigator": false,
    "adjust_viewport_to_content": false,
    "wait_for_images": false,
    "ignore_body_visibility": true,
    "keep_data_attributes": false,
    "keep_attrs": [],
    "remove_forms": false,
    "prettiify": false,
    "table_score_threshold": 7,
    "image_description_min_word_threshold": 50,
    "image_score_threshold": 5,
    "score_links": false,
    "method": "GET",
    "stream": false,
    "check_robots_txt": false,
    "experimental": null
  },

  # ============================================
  # 预留配置 (未来扩展)
  # ============================================

  # HTTP配置 (HTTPCrawlerConfig) - 预留
  "http": {
    "method": "GET",
    "headers": {},
    "follow_redirects": true,
    "verify_ssl": true
  },

  # 地理位置配置 (GeolocationConfig) - 预留
  "geolocation": {
    "latitude": null,
    "longitude": null,
    "accuracy": 0.0
  },

  # 代理配置 (ProxyConfig) - 预留
  "proxy": {
    "server": null,
    "username": null,
    "password": null
  },

  # 虚拟滚动配置 (VirtualScrollConfig) - 预留
  "virtual_scroll": {
    "container_selector": null,
    "scroll_count": 10,
    "wait_after_scroll": 0.5
  },

  # 链接预览配置 (LinkPreviewConfig) - 预留
  "link_preview": {
    "include_internal": true,
    "include_external": false,
    "max_links": 100
  },

  # LLM配置 (LLMConfig) - 预留
  "llm": {
    "provider": "openai/gpt-4o",
    "api_token": null
  },

  # 种子配置 (SeedingConfig) - 预留
  "seeding": {
    "source": "sitemap+cc",
    "max_urls": -1
  }
}
