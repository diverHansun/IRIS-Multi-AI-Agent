{
  "anthropic": {
    "description": "Anthropic Claude models configured for deep agents",
    "default_model": "claude-4.5-sonnet",
    "api_config": {
      "base_url": "https://api.openai-proxy.org/v1",
      "api_key_env": "ANTHROPIC_API_KEY"
    },
    "models": {
      "claude-4.5-sonnet": {
        "llm_params": {
          "temperature": 0.6,
          "max_tokens": 4096,
          "streaming": false
        },
        "runtime_config": {
          "recursion_limit": 300,
          "step_timeout": 120,
          "stream_mode": "updates"
        },
        "middleware_config": {
          "filesystem": "default",
          "subagents": "default"
        },
        "display_config": {
          "streaming_enabled": true,
          "show_reasoning_steps": true,
          "show_tool_calls": true,
          "show_tool_results": true,
          "show_subagent_delegations": true,
          "show_elapsed_time": true
        },
        "safety_config": {
          "max_execution_time": 120,
          "hitl_config": {
            "dangerous_tools": ["delete_file", "execute_shell", "rm", "sudo"],
            "tools": {
              "delete_file": {
                "allow_auto_approve": false,
                "warning_message": "This operation cannot be undone!"
              }
            }
          }
        },
        "metadata": {
          "context_window": 200000,
          "supports_tools": true,
          "max_input_tokens": 100000,
          "max_output_tokens": 50000
        }
      }
    }
  },
  "tongyi": {
