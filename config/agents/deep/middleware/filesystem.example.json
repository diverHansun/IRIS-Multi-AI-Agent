{
  "enabled": true,
  "default_mode": "read_only",
  "mode": "read_only",
  "long_term_memory": false,
  "tool_token_limit_before_evict": 20000,
  "security": {
    "allowed_paths": [
      "/workspace/",
      "/data/",
      "/tmp/"
    ],
    "excluded_paths": [
      "/etc/",
      "/root/",
      "/home/"
    ],
    "max_file_size": 10485760,
    "max_file_lines": 50000,
    "excluded_extensions": [
      ".exe",
      ".bat",
      ".sh"
    ]
  },
  "modes": {
    "read_only": {
      "description": "Restrict filesystem access to read-only operations for safe exploration.",
      "security": {
        "allowed_paths": [
          "/workspace/",
          "/data/",
          "/tmp/"
        ],
        "excluded_paths": [
          "/etc/",
          "/root/",
          "/home/"
        ],
        "max_file_size": 10485760,
        "max_file_lines": 50000,
        "excluded_extensions": [
          ".exe",
          ".bat",
          ".sh"
        ]
      }
    },
    "ask_before_edit": {
      "description": "Allow write operations with explicit confirmations before modifications.",
      "requires_confirmation": true,
      "security": {
        "allowed_paths": [
          "/workspace/",
          "/data/",
          "/tmp/"
        ],
        "excluded_paths": [
          "/etc/",
          "/root/",
          "/home/"
        ],
        "max_file_size": 5242880,
        "max_file_lines": 40000,
        "excluded_extensions": [
          ".exe",
          ".bat",
          ".sh"
        ]
      }
    },
    "auto_edit": {
      "description": "Enable automated write and edit operations across permitted paths.",
      "requires_confirmation": false,
      "security": {
        "allowed_paths": [
          "/workspace/",
          "/data/",
          "/tmp/"
        ],
        "excluded_paths": [
          "/etc/",
          "/root/"
        ],
        "max_file_size": 10485760,
        "max_file_lines": 50000,
        "excluded_extensions": [
          ".exe",
          ".bat"
        ]
      }
    }
  }
}
