{
  "_comment": "BasicAgents Provider Configuration Example - Complete Agent Configuration",
  "_usage": "This file demonstrates complete agent configuration with API credentials and agent parameters",
  "_reference": "See schema.json for field definitions and validation rules",
  "_note": "Remove comments (lines starting with '_') when creating actual config files",

  "schema_version": "1.0",
  "description": "BasicAgents provider configuration with complete API and agent parameters",

  "providers": {

    "ANTHROPIC": {
      "name": "Anthropic",
      "api_key_env": "ANTHROPIC_API_KEY",
      "base_url": "https://api.anthropic.com/v1",
      "base_url_env": "ANTHROPIC_BASE_URL",
      "default_model": "claude-3-5-sonnet",

      "models": {
        "claude-3-5-sonnet": {
          "name": "Claude 3.5 Sonnet",
          "description": "Most intelligent model with balanced speed and capabilities",
          "agent_type": "function_calling",
          "temperature": 0.1,
          "max_tokens": 8192,
          "context_window": 200000,
          "max_iterations": 12,
          "max_execution_time": 300,
          "memory_enabled": true,
          "supports_tools": true,
          "streaming": false
        },

        "claude-3-opus": {
          "name": "Claude 3 Opus",
          "description": "Most powerful Claude model for complex tasks",
          "agent_type": "function_calling",
          "temperature": 0.1,
          "max_tokens": 8192,
          "context_window": 200000,
          "max_iterations": 20,
          "max_execution_time": 600,
          "memory_enabled": true,
          "supports_tools": true,
          "streaming": false
        },

        "claude-3-haiku": {
          "name": "Claude 3 Haiku",
          "description": "Fastest model for simple tasks and testing",
          "agent_type": "function_calling",
          "temperature": 0.2,
          "max_tokens": 4096,
          "context_window": 200000,
          "max_iterations": 8,
          "max_execution_time": 180,
          "memory_enabled": true,
          "supports_tools": true,
          "streaming": false
        }
      }
    },

    "CUSTOM_PROVIDER": {
      "name": "Custom Provider",
      "api_key_env": "CUSTOM_API_KEY",
      "base_url": "https://api.custom.com/v1",
      "base_url_env": "CUSTOM_BASE_URL",
      "default_model": "custom-pro",

      "models": {
        "custom-pro": {
          "name": "Custom Pro Model",
          "description": "Full-featured model with thinking mode and extended iterations",
          "agent_type": "function_calling",
          "temperature": 0.1,
          "max_tokens": 8192,
          "context_window": 128000,
          "max_iterations": 15,
          "max_execution_time": 600,
          "memory_enabled": true,
          "supports_tools": true,
          "streaming": false,
          "thinking_mode": true
        },

        "custom-lite": {
          "name": "Custom Lite Model",
          "description": "Lightweight model with fixed temperature and reduced iterations",
          "agent_type": "function_calling",
          "temperature": 1.0,
          "temperature_fixed": true,
          "max_tokens": 4096,
          "context_window": 32768,
          "max_iterations": 8,
          "max_execution_time": 300,
          "memory_enabled": true,
          "supports_tools": true,
          "streaming": false
        },

        "custom-react": {
          "name": "Custom ReAct Model",
          "description": "Model using ReAct pattern instead of function calling",
          "agent_type": "react",
          "temperature": 0.1,
          "max_tokens": 4096,
          "context_window": 65536,
          "max_iterations": 10,
          "max_execution_time": 300,
          "memory_enabled": true,
          "supports_tools": false,
          "streaming": false
        }
      }
    },

    "LOCAL_MODEL": {
      "name": "Local Model Provider",
      "api_key_env": null,
      "base_url": "http://localhost:8000",
      "base_url_env": "LOCAL_MODEL_URL",
      "default_model": "auto",

      "models": {},

      "extra_params": {
        "timeout": 60,
        "keep_alive": "5m"
      }
    }
  }
}
