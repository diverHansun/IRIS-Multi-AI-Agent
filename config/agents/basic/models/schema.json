{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BasicAgents Providers Configuration Schema",
  "description": "Schema for BasicAgents configuration with complete API and agent parameters",
  "type": "object",
  "required": ["schema_version", "providers"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "description": {
      "type": "string",
      "description": "Description of configuration file purpose"
    },
    "providers": {
      "type": "object",
      "patternProperties": {
        "^[A-Z_]+$": {
          "type": "object",
          "required": ["name", "default_model", "models"],
          "properties": {
            "name": {
              "type": "string",
              "description": "Display name of the provider"
            },
            "default_model": {
              "type": "string",
              "description": "Model to use when not specified"
            },
            "api_key_env": {
              "type": ["string", "null"],
              "description": "Environment variable name for API key"
            },
            "base_url": {
              "type": ["string", "null"],
              "description": "Default API base URL"
            },
            "base_url_env": {
              "type": ["string", "null"],
              "description": "Environment variable for base_url override"
            },
            "models": {
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z0-9._-]+$": {
                  "$ref": "#/definitions/agent_model"
                }
              },
              "additionalProperties": false
            },
            "extra_params": {
              "type": "object",
              "description": "Provider-specific extra parameters"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "agent_model": {
      "type": "object",
      "required": ["name", "description", "agent_type", "supports_tools"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name of the model"
        },
        "description": {
          "type": "string",
          "description": "Brief description of model capabilities"
        },
        "agent_type": {
          "type": "string",
          "enum": ["react", "function_calling"],
          "description": "Type of agent implementation"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Default sampling temperature"
        },
        "temperature_fixed": {
          "type": "boolean",
          "description": "Whether temperature cannot be changed"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum output tokens"
        },
        "context_window": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum context window size"
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum agent iterations"
        },
        "max_execution_time": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum execution time in seconds"
        },
        "memory_enabled": {
          "type": "boolean",
          "description": "Enable conversation memory"
        },
        "supports_tools": {
          "type": "boolean",
          "description": "Whether model supports function/tool calling"
        },
        "streaming": {
          "type": "boolean",
          "description": "Enable streaming responses by default"
        },
        "thinking_mode": {
          "type": "boolean",
          "description": "Enable chain-of-thought reasoning"
        }
      },
      "additionalProperties": false
    }
  }
}
