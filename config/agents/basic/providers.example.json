{
  "schema_version": "2.0",
  "description": "BasicAgents provider configuration with complete API and agent parameters",
  "providers": {
    "zhipu": {
      "adapter": "zhipu",
      "name": "Zhipu AI",
      "api_key_env": "ZHIPU_API_KEY",
      "base_url": null,
      "base_url_env": null,
      "default_model": "glm-4.7-flash",
      "models": {
        "glm-4-plus": {
          "name": "GLM-4-Plus",
          "description": "Zhipu AI flagship model with comprehensive capabilities",
          "agent_type": "react",
          "temperature": 0.2,
          "max_tokens": 2048,
          "context_window": 128000,
          "max_iterations": 8,
          "max_execution_time": 300,
          "memory_enabled": true,
          "supports_tools": true,
          "streaming": false
        },
        "glm-4.7": {
          "name": "GLM-4.7",
          "description": "Next-gen MoE architecture model with 128K context, specialized in code reasoning and tool calling",
          "agent_type": "function_calling",
          "temperature": 0.1,
          "max_tokens": 8192,
          "context_window": 128000,
          "max_iterations": 15,
          "max_execution_time": 180,
          "memory_enabled": true,
          "supports_tools": true,
          "streaming": false,
          "thinking_mode": false
        },
        "glm-4.7-flash": {
          "name": "GLM-4.7-Flash",
          "description": "Free lightning version with 128K context and fast reasoning",
          "agent_type": "function_calling",
          "temperature": 0.1,
          "max_tokens": 96000,
          "context_window": 128000,
          "max_iterations": 15,
          "max_execution_time": 200,
          "memory_enabled": true,
          "supports_tools": true,
          "streaming": false,
          "thinking_mode": false
        }
      }
    },
    "openai": {
      "adapter": "openai",
      "name": "OpenAI",
      "api_key_env": "OPENAI_API_KEY",
      "base_url": "https://api.openai.com/v1",
      "base_url_env": "OPENAI_BASE_URL",
      "default_model": "gpt-4o-mini",
      "models": {
        "gpt-5": {
          "name": "GPT-5",
          "description": "Next-gen language model with enhanced reasoning and creativity",
          "agent_type": "function_calling",
          "temperature": 1.0,
          "temperature_fixed": true,
          "max_tokens": 8192,
          "context_window": 8192,
          "max_iterations": 15,
          "max_execution_time": 600,
          "memory_enabled": true,
          "supports_tools": true,
          "streaming": false
        },
        "gpt-5-mini": {
          "name": "GPT-5-mini",
          "description": "Cost-optimized GPT-5 version with fast performance",
          "agent_type": "function_calling",
          "temperature": 1.0,
          "temperature_fixed": true,
          "max_tokens": 32768,
          "context_window": 32768,
          "max_iterations": 15,
          "max_execution_time": 600,
          "memory_enabled": true,
          "supports_tools": true,
          "streaming": false
        },
        "gpt-4o": {
          "name": "GPT-4o",
          "description": "OpenAI GPT-4 optimized version with balanced performance and cost",
          "agent_type": "function_calling",
          "temperature": 0.1,
          "max_tokens": 4096,
          "context_window": 131072,
          "max_iterations": 10,
          "max_execution_time": 300,
          "memory_enabled": true,
          "supports_tools": true,
          "streaming": false
        },
        "gpt-4o-mini": {
          "name": "GPT-4o-mini",
          "description": "Lightweight GPT-4o version with fast speed and low cost",
          "agent_type": "function_calling",
          "temperature": 0.1,
          "max_tokens": 16384,
          "context_window": 131072,
          "max_iterations": 10,
          "max_execution_time": 300,
          "memory_enabled": true,
          "supports_tools": true,
          "streaming": false
        },
        "gpt-4.1-nano": {
          "name": "GPT-4.1-nano",
          "description": "Low-cost GPT for debugging and testing",
          "agent_type": "function_calling",
          "temperature": 0.1,
          "max_tokens": 4096,
          "context_window": 4096,
          "max_iterations": 8,
          "max_execution_time": 300,
          "memory_enabled": true,
          "supports_tools": true,
          "streaming": false
        }
      }
    },
    "tongyi": {
      "adapter": "openai",
      "name": "Tongyi Qwen",
      "api_key_env": "TONGYI_API_KEY",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "base_url_env": "TONGYI_BASE_URL",
      "default_model": "qwen3-max",
      "models": {
        "qwen3-max": {
          "name": "Qwen3 Max",
          "description": "Full-featured Qwen model",
          "agent_type": "function_calling",
          "temperature": 0.6,
          "max_tokens": 4096,
          "context_window": 128000,
          "max_iterations": 10,
          "max_execution_time": 300,
          "memory_enabled": true,
          "supports_tools": true,
          "streaming": false
        },
        "qwen3-coder-plus": {
          "name": "Qwen3 Coder Plus",
          "description": "Code-optimized Qwen model",
          "agent_type": "function_calling",
          "temperature": 0.6,
          "max_tokens": 8192,
          "context_window": 128000,
          "max_iterations": 10,
          "max_execution_time": 300,
          "memory_enabled": true,
          "supports_tools": true,
          "streaming": false
        }
      }
    }
  }
}
