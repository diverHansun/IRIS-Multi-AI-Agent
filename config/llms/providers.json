      "name": "Ollama本地模型",
      "default_model": "auto",
      "api_key_env": null,
      "class": null,
      "mode_defaults": {
        "llm": {
          "temperature": 0.1,
          "streaming": true
        },
        "agent": {
          "temperature": 0.0,
          "memory_enabled": true,
          "max_iterations": 3,
          "max_execution_time": 30,
          "streaming": false
        }
      },
      "models": {}
    }
  }
}