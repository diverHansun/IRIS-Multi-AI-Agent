{
  "schema_version": "1.0",
  "providers": {
    "ZHIPU": {
      "name": "智谱AI",
      "default_model": "glm-4.5",
      "mode_defaults": {
        "llm": {
          "temperature": 0.1,
          "streaming": true
        },
        "agent": {
          "temperature": 0.1,
          "memory_enabled": true,
          "max_iterations": 8,
          "max_execution_time": 300,
          "streaming": false
        }
      },
      "models": {
        "glm-4-plus": {
          "name": "GLM-4-Plus",
          "description": "智谱AI最新旗舰模型，综合能力强",
          "recommended": true,
          "model_features": [
            "通用对话",
            "推理分析",
            "工具调用",
            "成本优化"
          ],
          "supports_tools": true,
          "max_tokens": 2048,
          "context_window": 128000
        },
        "glm-4.5": {
          "name": "GLM-4.5",
          "description": "智谱AI新一代MoE架构模型，支持128K上下文，专精代码推理和工具调用",
          "recommended": true,
          "model_features": [
            "深度思考模式",
            "128K长上下文",
            "代码生成专精",
            "工具调用优化",
            "复杂推理增强"
          ],
          "supports_tools": true,
          "max_tokens": 8192,
          "context_window": 128000,
          "mode_overrides": {
            "llm": {
              "thinking_mode": true
            },
            "agent": {
              "max_iterations": 15,
              "max_execution_time": 180
            }
          }
        }
      }
    },
    "OPENAI": {
      "name": "OpenAI",
      "default_model": "gpt-4o-mini",
      "api_key_env": "OPENAI_API_KEY",
      "class": "OpenAILLM",
      "mode_defaults": {
        "llm": {
          "temperature": 0.1,
          "streaming": true
        },
        "agent": {
          "temperature": 0.1,
          "memory_enabled": true,
          "max_iterations": 10,
          "max_execution_time": 300,
          "streaming": false
        }
      },
      "models": {
        "gpt-5": {
          "name": "GPT-5",
          "description": "新一代语言模型，推理和创造能力显著提升",
          "recommended": true,
          "model_features": [
            "高级推理能力",
            "增强创造性思维",
            "精准工具调用",
            "深度上下文理解",
            "优化任务执行"
          ],
          "default_temperature": 1.0,
          "temperature_fixed": true,
          "supports_tools": true,
          "max_tokens": 8192,
          "context_window": 8192,
          "mode_overrides": {
            "llm": {
              "temperature": 1.0
            },
            "agent": {
              "temperature": 1.0,
              "max_iterations": 15,
              "max_execution_time": 600
            }
          }
        },
        "gpt-5-mini": {
          "name": "GPT-5-mini",
          "description": "GPT-5成本优化版本，速度快成本低",
          "recommended": true,
          "model_features": [
            "快速推理",
            "成本优化",
            "工具调用",
            "长上下文"
          ],
          "default_temperature": 1.0,
          "temperature_fixed": true,
          "supports_tools": true,
          "max_tokens": 32768,
          "context_window": 32768,
          "mode_overrides": {
            "llm": {
              "temperature": 1.0
            },
            "agent": {
              "temperature": 1.0,
              "max_iterations": 15,
              "max_execution_time": 600
            }
          }
        },
        "gpt-4o": {
          "name": "GPT-4o",
          "description": "OpenAI GPT-4优化版本，性能和成本平衡",
          "recommended": true,
          "model_features": [
            "多模态",
            "长上下文",
            "成本优化"
          ],
          "supports_tools": true,
          "max_tokens": 4096,
          "context_window": 131072
        },
        "gpt-4o-mini": {
          "name": "GPT-4o-mini",
          "description": "轻量级GPT-4o版本，速度快成本低",
          "recommended": true,
          "model_features": [
            "多模态",
            "长上下文",
            "快速推理",
            "成本优化"
          ],
          "supports_tools": true,
          "max_tokens": 16384,
          "context_window": 131072
        },
        "gpt-4-turbo": {
          "name": "GPT-4-Turbo",
