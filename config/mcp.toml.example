enabled = true
auto_start = true
prefer_mcp = true
namespace_strategy = "prefix"
default_prefix = "mcp_"

# Example configuration for Filesystem MCP
# Filesystem MCP allows reading files from the local filesystem
[servers.filesystem]
transport = "stdio"
command = "npx"
args = ["-y", "@modelcontextprotocol/server-filesystem", "./data"]
rename_prefix = "fs:"

# Example configuration for Notion MCP
# Notion MCP allows interacting with Notion pages and databases
[servers.notion]
transport = "stdio"
command = "npx"
args = ["-y", "notion-mcp"]
rename_prefix = "notion:"

[servers.notion.env]
NOTION_CLIENT_ID = "$NOTION_CLIENT_ID"
NOTION_CLIENT_SECRET = "$NOTION_CLIENT_SECRET"
NOTION_REDIRECT_URI = "$NOTION_REDIRECT_URI"

# Example configuration for Context7 MCP
# Context7 MCP provides web search and browsing capabilities
[servers.context7]
transport = "stdio"
command = "npx"
args = ["-y", "@upstash/context7-mcp", "--transport", "stdio"]
rename_prefix = "ctx7:"

[servers.context7.env]
CONTEXT7_MCP_URL = "https://mcp.context7.com/mcp"
CONTEXT7_API_KEY = "$CONTEXT7_API_KEY"

