# 基础LLM配置
# 至少设置一个：ZHIPU_API_KEY、OPENAI_API_KEY 或使用 Ollama 本地模型
ZHIPU_API_KEY=
OPENAI_API_KEY=
# 可自定义OpenAI兼容接口地址（留空则使用默认）
OPENAI_BASE_URL=https://api.openai-proxy.org

# Ollama 本地模型配置（无需API密钥）
# 确保已安装并启动 Ollama 服务：ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=60
OLLAMA_KEEP_ALIVE=5m
DEFAULT_OLLAMA_MODEL=gpt-oss:20b

# 默认提供商与模型（可选）
# 可选值：zhipu、openai 或 ollama
DEFAULT_LLM_PROVIDER=zhipu
# 如使用智谱，可设：glm-4-plus / glm-4-5 等；如使用OpenAI，可设：gpt-4o / gpt-4o-mini / gpt-5 等；如使用Ollama，可设：qwen2.5:7b / llama3.1:8b 等
DEFAULT_LLM_MODEL=glm-4


# 第三方工具：Tavily 搜索（可选）
TAVILY_API_KEY=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

# 第三方工具：高德地图（可选）
AMAP_API_KEY=

# 第三方工具：Notion（可选）
NOTION_TOKEN=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


